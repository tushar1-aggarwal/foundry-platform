task_*/

# Local-only ark state for `make test-e2e-t6-docker` (server.pid, secrets.json,
# session worktrees, recordings). Per-machine; never committed.
.tmp/

# Skill Hub sync-state sidecars — per-user-per-machine state binding a
# local skill dir to its server-side current_hash. Sharing across users
# via git would cause false-conflict reports on the next sync (RFC §7).
.ark/skills-state/

# Planning artifacts dropped by agents -- never tracked.
PLAN.md

