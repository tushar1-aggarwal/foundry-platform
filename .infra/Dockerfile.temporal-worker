# Hybrid image: oven/bun base supplies the cached Linux userland and Bun
# runtime (which we still need to install npm deps fast via `bun install`),
# then we layer Node+tsx on top so the worker entrypoint runs under Node.
#
# Why Node for the worker: the Temporal worker SDK relies on
# `v8.promiseHooks.createHook` to detect workflow microtask-queue drain.
# Bun's V8 build doesn't expose that API; the SDK's setImmediate fallback
# also misbehaves under Bun on Apple Silicon (workflow tasks always TIMED_OUT
# at 10s). Running the worker entrypoint on Node sidesteps this entirely;
# the rest of Ark stays on Bun.
# Pull AWS CLI v2 from Docker Hub (Zscaler-trusted; avoids awscli.amazonaws.com block).
FROM amazon/aws-cli:latest AS aws-cli-src

FROM oven/bun:1.3-slim
WORKDIR /app
# Install Node + npm from Debian's repo (Node 20 LTS, which is fine -- the
# Temporal worker SDK supports Node 18+). Avoids the Zscaler-MITM-blocked
# nodesource pull.
RUN apt-get update && apt-get install -y --no-install-recommends \
        nodejs npm curl git tmux procps unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g tsx

# AWS CLI v2 -- copied from Docker Hub image to avoid Zscaler-blocked direct download.
COPY --from=aws-cli-src /usr/local/aws-cli /usr/local/aws-cli
RUN ln -sf /usr/local/aws-cli/v2/current/bin/aws /usr/local/bin/aws \
    && ln -sf /usr/local/aws-cli/v2/current/bin/aws_completer /usr/local/bin/aws_completer

# session-manager-plugin -- fetched directly from AWS's S3 bucket. Required only
# by the EC2 compute backend (`packages/core/compute/ec2/*`) for SSM-based
# port-forwarding into private-VPC instances; unused on the current K8s-only
# production deploy but kept here so the image stays compatible when an EC2
# target is added.
#
# Network note: s3.amazonaws.com is reachable from GitHub-hosted CI runners
# directly. Developer laptops behind Zscaler may see this download fail with
# a TLS-MITM error; fix on the laptop side by trusting the Zscaler root or
# building with the docker daemon network configured to use a proxy that
# bypasses MITM for amazonaws.com hosts. The previous .tmp/-pre-stage shape
# was removed because it broke CI for everyone.
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) SMP_URL=https://s3.amazonaws.com/session-manager-downloads/plugin/latest/ubuntu_64bit/session-manager-plugin.deb ;; \
      arm64) SMP_URL=https://s3.amazonaws.com/session-manager-downloads/plugin/latest/ubuntu_arm64/session-manager-plugin.deb ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/smp.deb "$SMP_URL"; \
    dpkg -i /tmp/smp.deb; \
    rm /tmp/smp.deb
# Pull kubectl from a multi-arch image (Docker Hub is Zscaler-trusted, dl.k8s.io is MITM-blocked).
COPY --from=bitnami/kubectl:latest /opt/bitnami/kubectl/bin/kubectl /usr/local/bin/kubectl
COPY package.json bun.lock* ./
# bun install is fast and we already have the cached layer from previous builds.
# The worker doesn't actually need bun:sqlite at runtime (Postgres-only mode).
RUN bun install --frozen-lockfile --ignore-scripts
# The Anthropic Agent SDK ships per-platform native `claude` binaries as
# optional deps. bun-install pulls BOTH the glibc and musl variants for the
# target arch. On this glibc base the SDK's libc detection sometimes picks
# the musl variant first and fails with "claude binary not found" (the file
# exists but its dynamic loader is missing). Drop the musl variants so the
# detector only has one option.
RUN rm -rf node_modules/@anthropic-ai/claude-agent-sdk-*-musl
COPY . .
RUN chmod +x scripts/temporal-worker-entrypoint.sh /app/ark && ln -sf /app/ark /usr/local/bin/ark
CMD ["scripts/temporal-worker-entrypoint.sh"]

# Note (T6 / DockerIsolation): a previous iteration added the `docker` CLI
# here so this worker could spawn per-session sidecars from inside the
# compose stack. Reverted because the necessary binary fetches (download.
# docker.com / npm registry) get TLS-intercepted by Zscaler on this network,
# which corrupts tarballs and hangs bun-install. The runnable T6 path
# instead spawns the temporal worker on the HOST (where docker is already
# installed) and points it at the e2e Temporal :7234. See Makefile target
# `test-e2e-t6-docker` for the host-worker bootstrap.
#
# When Docker Desktop's daemon is configured to trust the Zscaler root CA
# (one-time UI op), re-enable the worker-in-compose path by reintroducing
# the docker CLI install and the /var/run/docker.sock mount in
# .infra/docker-compose.e2e.yaml.
