# pod-isolation test env (copy to .env.iso at repo root)
#
# Cluster
AWS_PROFILE=pai-risk-mlops
AWS_REGION=ap-south-1
EKS_CLUSTER=pai-risk-mlops-platform
EKS_NAMESPACE=ark

# Image
ARK_IMAGE=880170353725.dkr.ecr.ap-south-1.amazonaws.com/pai-mlops-platform/ark
ARK_IMAGE_TAG=276fbb07-merged

# Service account (must have IRSA mapping to AWS SSM read for /ark/default/*)
ARK_SERVICE_ACCOUNT=ark

# Test target
TEST_REPO=https://bitbucket.org/paytmteam/foundry-test-repo
TEST_SUMMARY=Add one paragraph to architecture.md

# Bedrock model slug (provider-qualified, what TF gateway expects)
TEST_MODEL=pi-agentic/global.anthropic.claude-haiku-4-5-20251001-v1-0
